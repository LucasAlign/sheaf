# Frontend: demo is explicitly device-local; live never falls back to demo data.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Preferred live data source. Replit supplies this automatically; AWS RDS uses
# the same setting later. When absent, the legacy Supabase data adapter is used.
DATABASE_URL=
# Optional organization seed values used by `npm run db:migrate`.
BRIDGE_ORGANIZATION_NAME=Keystone Family Alliance
BRIDGE_SERVICE_AREA=Pennsylvania
BRIDGE_CONTACT_EMAIL=
BRIDGE_EIN=
# Server only. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SHEAF_ORG_ID=c3206037-3638-4263-b18d-813a5895f1c8
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Keystone Family Alliance <care@your-verified-domain.org>
CRON_SECRET=
LINK_SIGNING_SECRET=
# Set true only on an always-on Replit Reserved VM, never Autoscale.
SHEAF_RUN_SCHEDULER=false
# Optional local database integration tests; use a disposable database only.
TEST_DATABASE_URL=
